# ============================================================
# 复制为 .env 后填写；程序不会自动读取 .env，
# 请先 `set -a; source .env; set +a`（Linux/macOS）
# 或 PowerShell: `Get-Content .env | ForEach-Object { ... }`
# 也可以直接设置进程环境变量。
# 不填 LLM_API_KEY 时，程序自动进入【离线回放模式】，无需联网即可演示。
# ============================================================

# OpenAI 兼容接口地址（DeepSeek 示例）
LLM_BASE_URL=https://api.deepseek.com
# 模型名（DeepSeek: deepseek-flash / deepseek-v4-pro）
LLM_MODEL=deepseek-flash
# 你的 API Key（切勿提交到 Git）
LLM_API_KEY=

# ---- 可选：反思与运行参数 ----
# 最多反思轮数
MAX_REFLECTIONS=2
# 评审分数达到该阈值即通过（0~1）
REFLECTION_THRESHOLD=0.85
# 单次任务内 ReAct 最大步数
MAX_STEPS=8
# 搜索返回条数
SEARCH_TOP_K=3
# 强制离线回放（1/true/yes）
OFFLINE=0
